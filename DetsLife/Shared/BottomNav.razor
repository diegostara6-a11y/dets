@namespace Dets.Components.Shared
@using Microsoft.AspNetCore.Components
@implements IAsyncDisposable
@inject NavigationManager Nav

<footer class="bottom-nav">
    <div class="nav-pill"
         style="@($"--active-index:{ActiveIndex}; --item-count:{Items.Length}")"
         aria-hidden="true">
    </div>

    @foreach (var item in Items)
    {
        <button @key="item.Route"
                class="nav-button"
                aria-label="@item.Label"
                aria-current="@(ActiveIndex == Array.IndexOf(Items, item) ? "page" : null)"
                @onclick="() => GoTo(item.Route)">
            @((MarkupString)item.Icon)
        </button>
    }
</footer>

@code {
    private record NavItem(string Label, string Route, string Icon);

    private readonly NavItem[] Items =
    {
        new("Home", "home", PointsIcon),
        new("Goals", "goals", GoalsIcon),
        new("Trophy", "trophy", TrophyIcon),
        new("Main", "", MainIcon),
        new("Finanze", "finances", FinanceIcon),
        new("Storico", "timeline", TimelineIcon),
        new("Calendario", "calendar", CalendarIcon)
    };

    private int ActiveIndex
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri)
                .Split('?')[0]
                .Trim('/')
                .ToLowerInvariant();

            // Homepage (empty path) corrisponde a "Main"
            if (string.IsNullOrEmpty(path))
                path = "";

            var index = Array.FindIndex(Items, x =>
                x.Route.Trim('/').ToLowerInvariant() == path);

            return index < 0 ? 0 : index;
        }
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private void GoTo(string route)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri)
            .Split('?')[0]
            .Trim('/');

        if (!string.Equals(current, route.Trim('/'),
            StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(route);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private const string FinanceIcon =
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'>" +
        "<path d='M8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4'/>" +
        "<path d='M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V6a2 2 0 0 1-2-2z'/>" +
        "</svg>";

    private const string TimelineIcon =
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'>" +
        "<path d='M4 11H2v3h2zm5-4H7v7h2zm5-5v12h-2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM6 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm-5 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z'/>" +
        "</svg>";

    private const string CalendarIcon =
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'>" +
        "<path d='M6.445 11.688V6.354h-.633A13 13 0 0 0 4.5 7.16v.695c.375-.257.969-.62 1.258-.777h.012v4.61zm1.188-1.305c.047.64.594 1.406 1.703 1.406 1.258 0 2-1.066 2-2.871 0-1.934-.781-2.668-1.953-2.668-.926 0-1.797.672-1.797 1.809 0 1.16.824 1.77 1.676 1.77.746 0 1.23-.376 1.383-.79h.027c-.004 1.316-.461 2.164-1.305 2.164-.664 0-1.008-.45-1.05-.82zm2.953-2.317c0 .696-.559 1.18-1.184 1.18-.601 0-1.144-.383-1.144-1.2 0-.823.582-1.21 1.168-1.21.633 0 1.16.398 1.16 1.23'/>" +
        "<path d='M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z'/>" +
        "</svg>";

    private const string MainIcon =
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'>" +
        "<path d='M14 4.577v6.846L8 15l-6-3.577V4.577L8 1zM8.5.134a1 1 0 0 0-1 0l-6 3.577a1 1 0 0 0-.5.866v6.846a1 1 0 0 0 .5.866l6 3.577a1 1 0 0 0 1 0l6-3.577a1 1 0 0 0 .5-.866V4.577a1 1 0 0 0-.5-.866z'/>" +
        "</svg>";

    private const string PointsIcon =
