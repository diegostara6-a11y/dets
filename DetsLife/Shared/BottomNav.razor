        "</svg>";

    private const string GoalsIcon =
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'>" +
        "<path d='M9.669.864 8 0 6.331.864l-1.858.282-.842 1.68-1.337 1.32L2.6 6l-.306 1.854 1.337 1.32.842 1.68 1.858.282L8 12l1.669-.864 1.858-.282.842-1.68 1.337-1.32L13.4 6l.306-1.854-1.337-1.32-.842-1.68zm1.196 1.193.684 1.365 1.086 1.072L12.387 6l.248 1.506-1.086 1.072-.684 1.365-1.51.229L8 10.874l-1.355-.702-1.51-.229-.684-1.365-1.086-1.072L3.614 6l.25-1.506 1.087-1.072.684-1.365 1.51-.229L8 1.126l1.356.702z'/>" +
        "<path d='M4 11.794V16l4-1 4 1v-4.206l-2.018.306L8 13.126 6.018 12.1z'/>" +
        "</svg>";

    private const string TrophyIcon = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" class=\"bi bi-trophy\" viewBox=\"0 0 16 16\"><path d=\"M2.5.5A.5.5 0 0 1 3 0h10a.5.5 0 0 1 .5.5q0 .807-.034 1.536a3 3 0 1 1-1.133 5.89c-.79 1.865-1.878 2.777-2.833 3.011v2.173l1.425.356c.194.048.377.135.537.255L13.3 15.1a.5.5 0 0 1-.3.9H3a.5.5 0 0 1-.3-.9l1.838-1.379c.16-.12.343-.207.537-.255L6.5 13.11v-2.173c-.955-.234-2.043-1.146-2.833-3.012a3 3 0 1 1-1.132-5.89A33 33 0 0 1 2.5.5m.099 2.54a2 2 0 0 0 .72 3.935c-.333-1.05-.588-2.346-.72-3.935m10.083 3.935a2 2 0 0 0 .72-3.935c-.133 1.59-.388 2.885-.72 3.935M3.504 1q.01.775.056 1.469c.13 2.028.457 3.546.87 4.667C5.294 9.48 6.484 10 7 10a.5.5 0 0 1 .5.5v2.61a1 1 0 0 1-.757.97l-1.426.356a.5.5 0 0 0-.179.085L4.5 15h7l-.638-.479a.5.5 0 0 0-.18-.085l-1.425-.356a1 1 0 0 1-.757-.97V10.5A.5.5 0 0 1 9 10c.516 0 1.706-.52 2.57-2.864.413-1.12.74-2.64.87-4.667q.045-.694.056-1.469z\" /></svg>";
}

<style>
.bottom-nav {
    position: fixed;
bottom: 0;
left: 50%;
transform: translateX(-50%);
z-index: 100;
width: min(450px, calc(100% - 40px));
height: 68px;
margin-bottom: calc(12px + env(safe-area-inset-bottom));
padding: 6px;
box-sizing: border-box;
display: flex;
align-items: center;
justify-content: space-around;
background: rgba(20, 20, 28, 0.88);
border: 1px solid rgba(255, 255, 255, 0.09);
border-radius: 24px;
box-shadow: 0 8px 30px rgba(0, 0, 0, 0.45);
backdrop-filter: blur(18px);
-webkit-backdrop-filter: blur(18px);
}

.nav-button {
position: relative;
z-index: 2;
flex: 1;
min-width: 0;
height: 54px;
display: flex;
align-items: center;
justify-content: center;
padding: 0;
border: none;
border-radius: 18px;
background: transparent;
color: white;
cursor: pointer;
-webkit-tap-highlight-color: transparent;
}

.nav-button svg {
width: 26px;
height: 26px;
fill: white;
display: block;
transition: transform 0.2s ease;
}

.nav-button:active svg {
transform: scale(0.85);
}

.nav-button:focus-visible {
outline: 2px solid white;
outline-offset: -4px;
}

.nav-pill {
position: absolute;
top: 6px;
bottom: 6px;
left: 6px;
width: calc((100% - 12px) / var(--item-count) - 6px);
border-radius: 19px;
background: rgba(165, 139, 255, 0.22);
border: 1px solid rgba(190, 170, 255, 0.28);
box-shadow: 0 0 18px rgba(140, 110, 255, 0.10);
pointer-events: none;
transform: translateX(calc(var(--active-index) * (100% + 6px)));
transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1);
will-change: transform;
}
</style>