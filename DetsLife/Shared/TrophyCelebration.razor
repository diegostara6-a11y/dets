@using DetsLife
@inject TrophyService Trophies
@implements IDisposable

@if (current is not null)
{
    <div class="tc-overlay" @onclick="CloseAsync" @key="current.Id">

        <div class="tc-confetti" aria-hidden="true">
            @for (int i = 0; i < 32; i++)
            {
                <span style="@ConfettiStyle(i)"></span>
            }
        </div>

        <div class="tc-card">
            <div class="tc-title">Trofeo ottenuto!</div>

            <div class="tc-stage">
                <div class="tc-ring tc-@Tier"></div>
                <div class="tc-ring tc-@Tier tc-ring2"></div>
                <div class="tc-medal tc-@Tier">
                    @if (!string.IsNullOrEmpty(current.BadgeFile))
                    {
                        <img src="images/trophies/@current.BadgeFile" alt="@current.Name" />
                    }
                    else
                    {
                        <span class="tc-emoji">@current.Icon</span>
                    }
                    <div class="tc-shine"></div>
                </div>
            </div>

            <div class="tc-name">@current.Name</div>
            <div class="tc-sub">@TierLabel · @(current.TimesEarned == 1 ? "prima volta" : $"{current.TimesEarned}ª volta")</div>

            @if (queue.Count > 0)
            {
                <div class="tc-more">+ altri @queue.Count</div>
            }

            <div class="tc-hint">Tocca per continuare</div>
        </div>
    </div>
}

@code {
    private readonly Queue<TrophyAlert> queue = new();
    private readonly HashSet<Guid> seen = new();
    private TrophyAlert? current;
    private CancellationTokenSource? cts;

    private string Tier => current?.Tier.ToString().ToLowerInvariant() ?? "bronze";

    private string TierLabel => current?.Tier switch
    {
        DetsLife.Tier.Silver => "Argento",
        DetsLife.Tier.Gold => "Oro",
        DetsLife.Tier.Platinum => "Platino",
        DetsLife.Tier.Diamond => "Diamante",
        _ => "Bronzo"
    };

    protected override async Task OnInitializedAsync()
    {
        Trophies.AlertsChanged += OnAlertsChanged;

        try
        {
            await Trophies.CheckAsync();   // controlla anche i trofei legati al tempo
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Errore animazione trofei: {ex}");
        }
    }

    private void OnAlertsChanged() =>
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });

    private async Task LoadAsync()
    {
        var alerts = await Trophies.GetAlertsAsync();

        foreach (var a in alerts.OrderBy(a => a.At))
        {
            if (seen.Add(a.Id))
                queue.Enqueue(a);
        }

        if (current is null)
            ShowNext();
    }

    private void ShowNext()
    {
        cts?.Cancel();

        if (queue.Count == 0)
        {
            current = null;
            return;
        }

        current = queue.Dequeue();
        cts = new CancellationTokenSource();
        _ = AutoCloseAsync(cts.Token);
    }

    private async Task AutoCloseAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(6000, ct);
            await InvokeAsync(CloseAsync);
        }
        catch (TaskCanceledException) { }
    }

    private async Task CloseAsync()
    {
        if (current is null) return;

        var id = current.Id;
        cts?.Cancel();
        current = null;

        await Trophies.DismissAlertAsync(id);

        ShowNext();
        StateHasChanged();
    }

    private static readonly string[] Palette =
        { "#ffd34d", "#ff6b6b", "#4dd2ff", "#7dff8a", "#c58bff", "#ffffff" };

    private static string ConfettiStyle(int i)
    {
        var left = (i * 37) % 100;
        var delay = (i % 8) * 0.14;
        var dur = 2.4 + (i % 5) * 0.35;
        var size = 6 + (i % 4) * 3;
        var rot = (i * 53) % 360;
        var color = Palette[i % Palette.Length];

        var height = size * 1.6;

        return FormattableString.Invariant($"left:{left}%;width:{size}px;height:{height:0.#}px;background:{color};animation-delay:{delay:0.##}s;animation-duration:{dur:0.##}s;transform:rotate({rot}deg);");
    }

    public void Dispose()
    {
        Trophies.AlertsChanged -= OnAlertsChanged;
        cts?.Cancel();
    }
}

<style>
    .tc-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 50% 45%, rgba(40,40,70,0.85), rgba(0,0,0,0.92));
        backdrop-filter: blur(4px);
        animation: tc-fade 0.35s ease both;
        cursor: pointer;
        overflow: hidden;
    }

    .tc-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 24px;
        text-align: center;
        color: white;
        animation: tc-pop 0.7s cubic-bezier(.2,1.5,.4,1) both;
    }

    .tc-title {
        font-size: 0.9rem;
        letter-spacing: 4px;
        text-transform: uppercase;
        opacity: 0.85;
        animation: tc-rise 0.6s 0.25s ease both;
    }

    .tc-stage {
        position: relative;
        width: 190px;
        height: 190px;
        margin: 10px 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tc-medal {
        position: relative;
        width: 150px;
        height: 150px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        box-shadow: inset 0 0 0 6px rgba(255,255,255,0.3), 0 12px 30px rgba(0,0,0,0.6);
        animation: tc-spin 1.1s cubic-bezier(.2,.9,.3,1.1) both, tc-float 3s 1.2s ease-in-out infinite;
    }

        .tc-medal img {
            width: 84px;
            height: 84px;
            object-fit: contain;
            filter: drop-shadow(0 3px 5px rgba(0,0,0,0.45));
        }

    .tc-emoji {
        font-size: 4rem;
    }

    .tc-shine {
        position: absolute;
        top: -20%;
        bottom: -20%;
        width: 40%;
        left: -60%;
        background: linear-gradient(100deg, transparent, rgba(255,255,255,0.65), transparent);
        transform: skewX(-20deg);
        animation: tc-shine 2.2s 0.9s ease-in-out infinite;
    }

    .tc-ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 3px solid currentColor;
        opacity: 0;
        animation: tc-ring 2s 0.4s ease-out infinite;
    }

    .tc-ring2 {
        animation-delay: 1.2s;
    }

    .tc-name {
        font-size: 1.5rem;
        font-weight: 800;
        animation: tc-rise 0.6s 0.55s ease both;
    }

    .tc-sub {
        font-size: 0.95rem;
        opacity: 0.8;
        animation: tc-rise 0.6s 0.7s ease both;
    }

    .tc-more {
        font-size: 0.8rem;
        opacity: 0.6;
    }

    .tc-hint {
        margin-top: 10px;
        font-size: 0.75rem;
        opacity: 0.45;
        animation: tc-rise 0.6s 1.1s ease both;
    }

    /* Colori dei tier */
    .tc-bronze {
        color: #e8a36a;
    }

    .tc-silver {
        color: #d7dce0;
    }

    .tc-gold {
        color: #ffd34d;
    }

    .tc-platinum {
        color: #cfe3ff;
    }

    .tc-diamond {
        color: #6fe3ff;
    }

    .tc-medal.tc-bronze {
        background: radial-gradient(circle at 30% 25%, #e8b182, #8a5a30 60%, #4a2d14);
        box-shadow: inset 0 0 0 6px rgba(255,255,255,0.3), 0 0 50px rgba(232,163,106,0.55);
    }

    .tc-medal.tc-silver {
        background: radial-gradient(circle at 30% 25%, #f2f4f6, #9aa0a6 60%, #5b6066);
        box-shadow: inset 0 0 0 6px rgba(255,255,255,0.3), 0 0 50px rgba(215,220,224,0.55);
    }

    .tc-medal.tc-gold {
        background: radial-gradient(circle at 30% 25%, #fff0a8, #d4a72c 60%, #7a5a0a);
        box-shadow: inset 0 0 0 6px rgba(255,255,255,0.3), 0 0 60px rgba(255,211,77,0.65);
    }

    .tc-medal.tc-platinum {
        background: radial-gradient(circle at 30% 25%, #f0f7ff, #a3b3c6 60%, #566274);
        box-shadow: inset 0 0 0 6px rgba(255,255,255,0.3), 0 0 60px rgba(207,227,255,0.6);
    }

    .tc-medal.tc-diamond {
        background: radial-gradient(circle at 30% 25%, #e6fbff, #52b3d8 60%, #1b516f);
        box-shadow: inset 0 0 0 6px rgba(255,255,255,0.3), 0 0 70px rgba(111,227,255,0.7);
    }

    /* Coriandoli */
    .tc-confetti {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
    }

        .tc-confetti span {
            position: absolute;
            top: -30px;
            border-radius: 2px;
            opacity: 0;
            animation-name: tc-fall;
            animation-timing-function: linear;
            animation-iteration-count: infinite;
        }

    @@keyframes tc-fade {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes tc-pop {
        from {
            opacity: 0;
            transform: scale(0.4);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes tc-rise {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes tc-spin {
        from {
            transform: rotateY(-540deg) scale(0.3);
            opacity: 0;
        }

        to {
            transform: rotateY(0) scale(1);
            opacity: 1;
        }
    }

    @@keyframes tc-float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    @@keyframes tc-shine {
        0% {
            left: -60%;
        }

        55%, 100% {
            left: 130%;
        }
    }

    @@keyframes tc-ring {
        0% {
            transform: scale(0.75);
            opacity: 0.8;
        }

        100% {
            transform: scale(1.35);
            opacity: 0;
        }
    }

    @@keyframes tc-fall {
        0% {
            transform: translateY(0) rotate(0deg);
            opacity: 0;
        }

        10% {
            opacity: 1;
        }

        100% {
            transform: translateY(110vh) rotate(720deg);
            opacity: 0.9;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .tc-card, .tc-medal, .tc-ring, .tc-shine, .tc-confetti span {
            animation: none !important;
        }

        .tc-confetti {
            display: none;
        }
    }
</style>
