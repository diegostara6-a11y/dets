@using global::DetsLife 
@page "/trophy"
@inject TrophyService Trophies

<div class="Root">

<header class="header">
    <h2>Trofei</h2>
    <span class="Summary">@earnedCount / @trophies.Count ottenuti</span>
</header>

@if (loadError is not null)
{
    <div class="ErrorMessage">
        <p>Impossibile caricare i trofei.</p>
        <pre>@loadError</pre>
    </div>
}
else if (isLoading)
{
    <p class="Loading">Caricamento trofei...</p>
}
else
{
    <div class="TrophyGrid">
        @foreach (var t in trophies)
        {
            <div class="Trophy @(t.IsEarned ? "" : "locked")" @key="t.Id">
                   <div class="Medal @t.TierCss">
                       <img class="MedalImg" src="images/trophies/@t.BadgeFile" alt="@t.Name" />
                   </div>

                <span class="TrophyName">@t.Name</span>
                <span class="TrophyDesc">@t.Description</span>

                <span class="TrophyCount">
                    @if (t.IsEarned)
                    {
                        @($"Ottenuto {t.TimesEarned} {(t.TimesEarned == 1 ? "volta" : "volte")}")
                    }
                    else
                    {
                        @("Non ancora ottenuto")
                    }
                </span>

                <div class="Bar">
                    <div style="@($"width:{Percent(t)}%")"></div>
                </div>

                <span class="BarLabel">@Progress(t) / @t.Target</span>
            </div>
        }
    </div>
}


</div>

@code { private List<global::DetsLife.Trophy> trophies = new(); private Stats? stats;

private bool isLoading = true;
private string? loadError;

private int earnedCount => trophies.Count(t => t.IsEarned);

protected override async Task OnInitializedAsync()
{
    try
    {
        await Trophies.CheckAsync();

        var data = await Trophies.GetDataAsync();

        trophies = data?.Trophies
            ?? new List<global::DetsLife.Trophy>();

        stats = await Trophies.GetStatsAsync();
    }
    catch (Exception ex)
    {
        Console.Error.WriteLine($"Errore caricamento trofei: {ex}");
        loadError = $"{ex.GetType().Name}: {ex.Message}";
    }
    finally
    {
        isLoading = false;
    }
}

private int Progress(global::DetsLife.Trophy t)
{
    try
    {
        if (stats is null || t.Target <= 0)
            return 0;

        return Math.Clamp(
            TrophyRules.Progress(t, stats),
            0,
            t.Target);
    }
    catch (Exception ex)
    {
        Console.Error.WriteLine($"Errore progresso trofeo '{t.Name}': {ex}");
        return 0;
    }
}

private int Percent(global::DetsLife.Trophy t)
{
    try
    {
        if (stats is null || t.Target <= 0)
            return 0;

        var percent = TrophyRules.Percent(t, stats) * 100;

        if (double.IsNaN(percent) || double.IsInfinity(percent))
            return 0;

        return (int)Math.Clamp(Math.Round(percent), 0, 100);
    }
    catch (Exception ex)
    {
        Console.Error.WriteLine($"Errore percentuale trofeo '{t.Name}': {ex}");
        return 0;
    }
}


}

<style>
html, body {
background-color: black;
margin: 0;
padding: 0;
overflow-x: hidden;
}

.Root {
min-height: 100vh;
color: white;
