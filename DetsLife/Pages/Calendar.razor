@page "/calendar"
@using System.Globalization
@using Dets.Models
@using Dets.Services
@inject HistoryService History
@inject ISavingService SavingService
@inject NavigationManager Nav
@inject GoogleCalendarService GoogleCalendar

@code {
    private async Task ImportFromGoogle()
    {
        var imported = await GoogleCalendar.ImportAsync(
            new DateTime(month.Year, month.Month, 1).AddMonths(-1),
            new DateTime(month.Year, month.Month, 1).AddMonths(3));

        // evita duplicati se reimporti
        foreach (var ev in imported)
        {
            bool exists = events.Any(e => e.Name == ev.Name
                && e.Day == ev.Day && e.Month == ev.Month && e.Year == ev.Year);
            if (!exists) events.Add(ev);
        }

        await SavingService.SaveAsync("events", events);
    }
}
<header class="header" @onclick='() => Nav.NavigateTo("")'>
    <h2>Punteggio Vita</h2>
</header>

@if (stats is null)
{
    <p>Caricamento...</p>
}
else
{
    <div class="cal">
        <div class="cal-head">
            <button class="cal-nav" @onclick="PrevMonth" aria-label="Mese precedente">‹</button>
            <strong>@MonthTitle()</strong>
            <button class="cal-nav" @onclick="NextMonth" aria-label="Mese successivo">›</button>
        </div>

        <div class="cal-grid cal-week">
            @foreach (var w in WeekDays)
            {
                <span>@w</span>
            }
        </div>

        <div class="cal-grid">
            @foreach (var day in DaysOfGrid())
            {
                if (day is null)
                {
                    <span class="cal-empty"></span>
                }
                else
                {
                    var d = day.Value;
                    <button class="cal-day @DayClass(d)" @onclick="() => selected = d">
                        <span class="cal-num">@d.Day</span>
                        @if (totals.TryGetValue(d, out var t))
                        {
                            <span class="cal-dot @(t >= 0 ? "up" : "down")"></span>
                        }
                        else if (events.Any(e => e.Date.Date == d.Date))
                        {
                            <span class="cal-dot up"></span>
                        }
                    </button>
                }
            }
        </div>
    </div>

    <button class="EventBtn" @onclick="ShowPopUp">
        <h2>Aggiungi Evento</h2>
    </button>

    <button class="EventBtn" @onclick="ImportFromGoogle">Importa da Google Calendar</button>

    <div class="cal-detail">
        <h4>@selected.ToString("dddd d MMMM", it)</h4>
        @{
            var items = stats.Where(s => s.Day == selected).OrderByDescending(s => Math.Abs(s.Points)).ToList();
        }
        @if (items.Count == 0)
        {
            <p class="cal-none">Nessun evento.</p>
        }
        else
        {
            <ul class="cal-list">
                @foreach (var s in items)
                {
                    <li>
                        <span>@s.Name @(s.Count > 1 ? $"×{s.Count}" : "")</span>
                        <strong class="@(s.Points >= 0 ? "pos" : "neg")">@(s.Points > 0 ? "+" : "")@s.Points</strong>
                    </li>
                }
            </ul>
            <p class="cal-total">Totale giorno: @items.Sum(x => x.Points)</p>
        }
    </div>
}


@{
    var dayEvents = events
        .Where(e => e.Date.Date == selected.Date)
        .ToList();
}

<h4>Eventi personali</h4>

@if (dayEvents.Count == 0)
{
    <p class="cal-none">Nessun evento personale.</p>
}
else
{
    <ul class="cal-list">
        @foreach (var ev in dayEvents)
        {
            <li @key="ev.Id">
                <div>
                    <strong>@ev.Name</strong>

                    @if (!string.IsNullOrWhiteSpace(ev.Description))
                    {
                        <p>@ev.Description</p>
                    }
                </div>
            </li>
        }
    </ul>
}

@if (showPopUp)
{
    <div class="PopupBackdrop" @onclick="ClosePopup">
        <div class="PopupBox" @onclick:stopPropagation="true">
            <h3>Aggiungi Evento</h3>
            <h5>@selected.ToString("dddd d MMMM yyyy", it)</h5>

            <label for="eventName">Nome evento</label>
            <input id="eventName"
                   class="PopupInput"
                   type="text"
                   @bind="eventName"
                   placeholder="Es. Verifica di matematica" />

            <label for="eventDescription">Descrizione</label>
            <textarea id="eventDescription"
                      class="PopupInput"
                      @bind="eventDescription"
                      placeholder="Descrizione dell'evento"></textarea>

            <div class="PopupButtons">
                <button class="PopupBtn cancel" @onclick="ClosePopup">
                    Annulla
                </button>
                <button class="PopupBtn ok" @onclick="SaveEvent">
                    Salva
                </button>
            </div>
        </div>
    </div>
}




@code {
    private const string FinanceIcon =
"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'>" +
"<path d='M8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4'/>" +
"<path d='M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V6a2 2 0 0 1-2-2z'/>" +
"</svg>";

    private const string TimelineIcon =
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'>" +
        "<path d='M4 11H2v3h2zm5-4H7v7h2zm5-5v12h-2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM6 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm-5 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z'/>" +
        "</svg>";

    private const string CalendarIcon =
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'>" +
        "<path d='M6.445 11.688V6.354h-.633A13 13 0 0 0 4.5 7.16v.695c.375-.257.969-.62 1.258-.777h.012v4.61zm1.188-1.305c.047.64.594 1.406 1.703 1.406 1.258 0 2-1.066 2-2.871 0-1.934-.781-2.668-1.953-2.668-.926 0-1.797.672-1.797 1.809 0 1.16.824 1.77 1.676 1.77.746 0 1.23-.376 1.383-.79h.027c-.004 1.316-.461 2.164-1.305 2.164-.664 0-1.008-.45-1.05-.82zm2.953-2.317c0 .696-.559 1.18-1.184 1.18-.601 0-1.144-.383-1.144-1.2 0-.823.582-1.21 1.168-1.21.633 0 1.16.398 1.16 1.23'/>" +
        "<path d='M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z'/>" +
        "</svg>";
    private static readonly CultureInfo it = new("it-IT");
    private static readonly string[] WeekDays = { "L", "M", "M", "G", "V", "S", "D" };
    private bool showPopUp = false;
    private List<Dets.Models.Event> events = new();

    private List<DayStat>? stats;
    private Dictionary<DateTime, int> totals = new();
    private DateTime month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime selected = DateTime.Today;

    private string eventName = "";
    private string eventDescription = "";

    private int ActiveIndex
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri)
                          .Split('?')[0]
                          .Trim('/')
                          .ToLowerInvariant();

            return path switch
            {
                "finances" => 0,
                "timeline" => 1,
                "calendar" => 2,
                _ => 0
            };
        }
    }

    private void GoTo(string route)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri)
                         .Split('?')[0]
                         .Trim('/');

        if (!string.Equals(current, route, StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo(route);
    }


    private void ShowPopUp()
    {
        eventName = "";
        eventDescription = "";
        showPopUp = true;
    }

    private void ClosePopup()
    {
        showPopUp = false;
    }

    private async Task SaveEvent()
    {
        if (string.IsNullOrWhiteSpace(eventName))
            return;

        var newEvent = new Dets.Models.Event
        {
            Name = eventName.Trim(),
            Description = eventDescription.Trim(),
            Day = selected.Day,
            Month = selected.Month,
            Year = selected.Year
        };

        events.Add(newEvent);

        await SavingService.SaveAsync("events", events);

        ClosePopup();
    }

    protected override async Task OnInitializedAsync()
    {
        // Carica lo storico dei punti
        stats = await History.GetDailyAsync();

        totals = stats
            .GroupBy(s => s.Day.Date)
            .ToDictionary(g => g.Key, g => g.Sum(s => s.Points));

        // Carica gli eventi personali salvati
        events = await SavingService.LoadAsync<List<Dets.Models.Event>>("events")
                 ?? new List<Dets.Models.Event>();
    }

    private void PrevMonth() => month = month.AddMonths(-1);
    private void NextMonth() => month = month.AddMonths(1);

    private string MonthTitle()
    {
        var s = month.ToString("MMMM yyyy", it);
        return char.ToUpper(s[0]) + s.Substring(1);
    }

    private List<DateTime?> DaysOfGrid()
    {
        var list = new List<DateTime?>();
        int offset = ((int)month.DayOfWeek + 6) % 7;   // lunedì = 0
        for (int i = 0; i < offset; i++) list.Add(null);
        int count = DateTime.DaysInMonth(month.Year, month.Month);
        for (int d = 1; d <= count; d++) list.Add(new DateTime(month.Year, month.Month, d));
        return list;
    }

    private string DayClass(DateTime d)
    {
        string c = "";
        if (d == DateTime.Today) c += " today";
        if (d == selected.Date) c += " sel";
        return c;
    }
}

<style>
    html, body {
    background-color: black;
    color: white;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
}

.cal-title {
    padding: 12px 16px 0;
    letter-spacing: 1px;
}

.cal {
    padding: 8px 12px;
}

.cal-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    font-size: 1.15rem;
}

.cal-head strong {
    text-transform: capitalize;
}

.cal-nav {
    background: transparent;
    border: none;
    color: #a58bff;
    font-size: 1.8rem;
    padding: 0 12px;
    cursor: pointer;
    border-radius: 10px;
}

.cal-nav:active {
    background: rgba(165, 139, 255, 0.15);
}

.cal-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
}

.cal-week span {
    text-align: center;
    font-size: 0.75rem;
    opacity: 0.6;
    padding-bottom: 4px;
}

.cal-empty {
    height: 46px;
}

.cal-day {
    height: 46px;
    background: transparent;
    border: none;
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    border-radius: 50%;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
}

.cal-day:active {
    background: rgba(255, 255, 255, 0.12);
}

.cal-num {
    width: 30px;
    height: 30px;
    line-height: 30px;
    border-radius: 50%;
    font-size: 1rem;
}

.cal-day.today .cal-num {
    background: #ff3b30;
}

.cal-day.sel:not(.today) .cal-num {
    background: rgba(255, 255, 255, 0.22);
}

.cal-day.sel.today .cal-num {
    box-shadow: 0 0 0 2px white;
}

.cal-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
}

.cal-dot.up {
            background: #a58bff;
}

.cal-dot.down {
    background: #ff6b6b;
}

/* Dettagli del giorno */
.cal-detail {
    margin: 12px;
    margin-bottom: 24px;
    padding: 16px;
    background: #1b1b24;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 18px;
    color: white;
}

.cal-detail h4 {
    margin: 0 0 12px;
    text-transform: capitalize;
}

.cal-none {
    opacity: 0.6;
    margin: 0;
    font-size: 0.9rem;
}

/* Storico dei punti */
.cal-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.cal-list li {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(128, 128, 128, 0.25);
}

.cal-list li:last-child {
    border-bottom: none;
}

.cal-list .pos {
    color: #5fd68e;
}

.cal-list .neg {
    color: #ff8a8a;
}

.cal-total {
    margin: 12px 0 0;
    opacity: 0.85;
    text-align: right;
    font-weight: 700;
}

/* Pulsante Aggiungi Evento */
.EventBtn {
    display: block;
    background: linear-gradient(135deg, #292938, #1b1b24);
    color: white;
    border: 1px solid rgba(165, 139, 255, 0.3);
    border-radius: 16px;
    padding: 12px 16px;
    margin: 14px 12px;
    width: calc(100% - 24px);
    text-align: center;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
    transition: transform 0.15s ease, filter 0.15s ease;
    -webkit-tap-highlight-color: transparent;
}

.EventBtn h2 {
    font-size: 1rem;
    margin: 0;
    font-weight: 700;
}

.EventBtn:active {
    transform: scale(0.98);
    filter: brightness(1.2);
}

/* Eventi personali */
.cal-event {
    background: #242431;
    border: 1px solid rgba(165, 139, 255, 0.15);
    border-radius: 12px;
    padding: 12px;
    margin-bottom: 10px;
}

.cal-event:last-child {
    margin-bottom: 0;
}

.cal-event-name {
    font-weight: 700;
    font-size: 1rem;
    overflow-wrap: anywhere;
}

.cal-event-description {
    margin: 6px 0 0;
    font-size: 0.88rem;
    line-height: 1.4;
    color: #c4c4d4;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

/* Popup */
.PopupBackdrop {
    position: fixed;
    inset: 0;
    padding: 20px;
    box-sizing: border-box;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
