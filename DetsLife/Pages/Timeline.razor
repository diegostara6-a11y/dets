        "</svg>";
    private const string MainIcon = 
        "<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='currentColor' class='bi bi-hexagon' viewBox='0 0 16 16'>" +
        "<path d='M14 4.577v6.846L8 15l-6-3.577V4.577L8 1zM8.5.134a1 1 0 0 0-1 0l-6 3.577a1 1 0 0 0-.5.866v6.846a1 1 0 0 0 .5.866l6 3.577a1 1 0 0 0 1 0l6-3.577a1 1 0 0 0 .5-.866V4.577a1 1 0 0 0-.5-.866z' />" +
        "<path d='M14 4.577v6.846L8 15l-6-3.577V4.577L8 1zM8.5.134a1 1 0 0 0-1 0l-6 3.577a1 1 0 0 0-.5.866v6.846a1 1 0 0 0 .5.866l6 3.577a1 1 0 0 0 1 0l6-3.577a1 1 0 0 0 .5-.866V4.577a1 1 0 0 0-.5-.866z' />" +
        "</svg>";

    private List<HistoryEntry>? entries;
    private List<DayStat>? stats;

    private int ActiveIndex
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri)
                          .Split('?')[0]
                          .Trim('/')
                          .ToLowerInvariant();

            return path switch
            {
                "finances" => 0,
                "timeline" => 1,
                "calendar" => 2,
                _ => 0
            };
        }
    }

    private void GoTo(string route)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri)
                         .Split('?')[0]
                         .Trim('/');

        if (!string.Equals(current, route, StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo(route);
    }



    protected override async Task OnInitializedAsync()
    {
        entries = await History.GetRecentAsync();
        stats = await History.GetDailyAsync();
    }

    // Andamento cumulativo su tutta la storia, mostrando gli ultimi 30 giorni
    private List<(DateTime Day, int Value)> Series()
    {
        var daily = stats!
            .GroupBy(s => s.Day)
            .OrderBy(g => g.Key)
            .Select(g => (Day: g.Key, Sum: g.Sum(s => s.Points)))
            .ToList();

        var result = new List<(DateTime Day, int Value)>();
        int running = 0;
        foreach (var d in daily)
        {
            running += d.Sum;
            result.Add((d.Day, running));
        }
        return result.TakeLast(30).ToList();
    }

    // Le 6 azioni che pesano di più sui punti
    private List<(string Name, int Count, int Points)> ActionTotals()
    {
        return stats!
            .GroupBy(s => s.Name)
            .Select(g => (Name: g.Key, Count: g.Sum(s => s.Count), Points: g.Sum(s => s.Points)))
            .ToList();
    }

    private RenderFragment Label(double x, double y, string cls, string anchor, string content) => builder =>
    {
        builder.OpenElement(0, "text");
        builder.AddAttribute(1, "x", x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
        builder.AddAttribute(2, "y", y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
        builder.AddAttribute(3, "class", cls);
        builder.AddAttribute(4, "text-anchor", anchor);
        builder.AddContent(5, content);
        builder.CloseElement();
    };

    private async Task DeleteEntry(HistoryEntry e)
    {
        string sign = e.Points > 0 ? "+" : "";
        bool ok = await JS.InvokeAsync<bool>("confirm",
            $"Eliminare \"{e.Name}\" ({sign}{e.Points})? I punti verranno tolti dal totale.");
        if (!ok) return;

        await History.RemoveAsync(e.Id);
        entries = await History.GetRecentAsync();
        stats = await History.GetDailyAsync();
    }
}

<style>
    html, body {
        background-color: black;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        color: white;
    }

    .li-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .del-btn {
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.55);
        padding: 4px;
        cursor: pointer;
    }

        .del-btn:hover {
            color: #ff8a8a;
        }

    .chart-card {
        background: linear-gradient(160deg, #1f1b3a, #2d2566);
        border-radius: 16px;
        padding: 12px 8px 4px;
        margin: 12px 0 16px;
        box-shadow: 0 6px 18px rgba(81, 43, 212, 0.35);
    }

    .line-chart {
        width: 100%;
        height: auto;
        display: block;
    }

        .line-chart .grid {
            stroke: rgba(255, 255, 255, 0.12);
            stroke-width: 1;
        }

        .line-chart .zero {
            stroke: rgba(255, 255, 255, 0.4);
            stroke-width: 1;
            stroke-dasharray: 4 3;
        }

        .line-chart .path {
            fill: none;
            stroke: #a58bff;
            stroke-width: 2.5;
            stroke-linejoin: round;
            stroke-linecap: round;
        }

        .line-chart .dot {
            fill: #fff;
            stroke: #7c5cff;
            stroke-width: 2;
        }

        .line-chart .xlabel, .line-chart .ylabel {
            fill: rgba(255, 255, 255, 0.75);
            font-size: 10px;
        }

    .top-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin: 0 0 16px;
    }

    .top-card {
        border-radius: 16px;
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        background: #1b1b24;
    }

        .top-card small {
            opacity: 0.7;
            font-size: 0.75rem;
        }

        .top-card strong {
            font-size: 1.1rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .top-card span {
            font-size: 0.85rem;
            opacity: 0.85;
        }

    .pos-card {
        border: 1px solid #2e9e5b;
        box-shadow: 0 4px 14px rgba(46, 158, 91, 0.25);
    }

        .pos-card strong {
            color: #5fd68e;
        }

    .neg-card {
        border: 1px solid #d14343;
        box-shadow: 0 4px 14px rgba(209, 67, 67, 0.25);
    }

        .neg-card strong {
            color: #ff8a8a;
        }

    .history-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .history-list li {
            display: flex;
            justify-content: space-between;
            padding: 10px 4px;
            border-bottom: 1px solid rgba(128, 128, 128, 0.25);
        }

        .history-list .pos {
            color: #2e9e5b;
