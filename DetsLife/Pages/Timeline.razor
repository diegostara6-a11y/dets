    /* Pillola semitrasparente animata */
    .NavPill {
        position: absolute;
        top: 6px;
        bottom: 6px;
        width: calc((100% - 12px) / 3);
        border-radius: 19px;
        background: rgba(165, 139, 255, 0.22);
        border: 1px solid rgba(190, 170, 255, 0.28);
        box-shadow: 0 0 18px rgba(140, 110, 255, 0.10);
        pointer-events: none;
        transition: left 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        left: 6px;
    }

        /* Posizione della pillola per ogni pagina */
        .NavPill.finances {
            left: 6px;
        }

        .NavPill.timeline {
            left: calc(6px + (100% - 12px) / 3);
        }

        .NavPill.calendar {
            left: calc(6px + 2 * (100% - 12px) / 3);
        }

    /* Nasconde gli effetti di focus predefiniti */
    .NavButton:focus {
        outline: none;
    }

    .NavButton:focus-visible {
        outline: 2px solid white;
        outline-offset: -4px;
    }

</style>