@using Microsoft.AspNetCore.Components.Web
@using global::DetsLife
@page "/home"
@inject ISavingService SavingService
@inject HistoryService History
@inject NavigationManager Nav


<div class="Root"
     @onpointerdown="OnPointerDown"
     @onpointerup="OnPointerUp"
     @onpointercancel="OnPointerCancel">

    <header class="header">
        <h2>Punteggio Vita</h2>
    </header>

    <div class="InfoBox @GetBackgroundColor(points)">
        <h1>@points</h1>
    </div>

    <div class="ActionGrid">
        @foreach (var action in actions)
        {
            <button class="ActionButton @(action.Value < 0 ? "negative" : "positive")"
                    @onclick="() => Apply(action)">
                <span class="ActionName">@action.Name</span>
                <span class="ActionValue">
                    @(action.Value > 0 ? "+" : "")@action.Value
                </span>
            </button>
        }
    </div>
</div>



