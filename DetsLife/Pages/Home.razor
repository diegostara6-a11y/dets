@using Microsoft.AspNetCore.Components.Web
@using global::DetsLife
@page "/home"
@inject ISavingService SavingService
@inject TrophyService Trophies
@inject HistoryService History
@inject NavigationManager Nav

<div class="Root"
     @onpointerdown="OnPointerDown"
     @onpointerup="OnPointerUp"
     @onpointercancel="OnPointerCancel">

    <header class="header">
        <h2>Punteggio Vita</h2>
        <div class="Dots">
            <span class="Dot on"></span>
            <span class="Dot"></span>
        </div>
    </header>

    <div class="InfoBox @GetBackgroundColor(points)">
        <h1>@points</h1>
    </div>

    <div class="ActionGrid">
        @foreach (var action in actions)
        {
            <button class="ActionButton @(action.Value < 0 ? "negative" : "positive")"
                    @onclick="() => Apply(action)">
                <span class="ActionName">@action.Name</span>
                <span class="ActionValue">
                    @(action.Value > 0 ? "+" : "")@action.Value
                </span>
            </button>
        }
    </div>
</div>

@code {
    private int points;
    private double? startX;
    private double startY;

    private readonly List<HabitAction> actions = HabitCatalog.Actions;

    protected override async Task OnInitializedAsync()
    {
        points = await SavingService.LoadAsync<int>("points");
    }

    private async Task Apply(HabitAction action)
    {
        points += action.Value;
        await SavingService.SaveAsync("points", points);
        await History.AddAsync(action.Name, action.Value);
        await Trophies.RecordAsync(action.Name, action.Value, points);
    }

    private string GetBackgroundColor(int value)
    {
        if (value < -25) return "red";
        if (value < 0) return "orange";
        if (value < 25) return "blue";
        return "gold";
    }

    private void OnPointerDown(PointerEventArgs e)
    {
        startX = e.ClientX;
        startY = e.ClientY;
    }

    private void OnPointerCancel(PointerEventArgs e)
    {
        startX = null;
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        if (startX is null) return;

        double dx = e.ClientX - startX.Value;
        double dy = e.ClientY - startY;
        startX = null;

        // Ignora movimenti brevi o prevalentemente verticali
        if (Math.Abs(dx) < 60 || Math.Abs(dy) > Math.Abs(dx))
            return;

        // Swipe verso sinistra: vai agli obiettivi
        if (dx < 0)
            Nav.NavigateTo("/goals");
    }
}

<style>
    html, body {
        background-color: black;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    .Root {
        min-height: 100vh;
        touch-action: pan-y;
        user-select: none;
        -webkit-user-select: none;
    }

    .header {
        position: sticky;
        top: 0;
        z-index: 10;
        margin: 0;
        padding: 12px 0 8px;
        text-align: center;
        color: white;
        background: #0b0b14;
        letter-spacing: 1px;
    }

    .Dots {
        display: flex;
        justify-content: center;
        gap: 8px;
        padding-top: 6px;
    }

    .Dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4b5563;
    }

        .Dot.on {
            background: white;
        }

    .InfoBox {
        box-sizing: border-box;
        width: 100%;
        height: 450px;
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        color: white;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
        transition: background 0.7s ease;
    }

        .InfoBox h1 {
            margin: 0;
            font-size: 4rem;
        }

    .red {
        background: linear-gradient(135deg, #ef4444, #7f1d1d);
    }

    .orange {
        background: linear-gradient(135deg, #fb923c, #b45309);
    }

    .blue {
        background: linear-gradient(135deg, #3b82f6, #1e3a8a);
    }

    .gold {
        background: linear-gradient(135deg, #fcd34d, #b8860b);
    }

    .ActionGrid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        padding: 16px 12px 90px; /* spazio per il footer fisso */
    }

    .ActionButton {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        min-height: 120px;
        padding: 14px;
        border: none;
        border-radius: 18px;
        color: white;
        text-align: left;
        cursor: pointer;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
        transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
        -webkit-tap-highlight-color: transparent;
        background: linear-gradient(135deg, grey, #5C5B5B);
    }

        .ActionButton.positive {
            background: linear-gradient(135deg, #22c55e, #166534);
        }

        .ActionButton.negative {
            background: linear-gradient(135deg, #f87171, #991b1b);
        }

        .ActionButton:hover {
            filter: brightness(1.08);
        }

        .ActionButton:active {
            transform: scale(0.95);
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
            filter: brightness(0.92);
        }

    .ActionName {
        font-size: 1.05rem;
        font-weight: 700;
    }

    .ActionValue {
        margin-top: auto;
        align-self: flex-end;
        padding: 3px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.25);
        font-weight: 700;
        font-size: 1.1rem;
    }

    footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-around;
        align-items: center;
        padding: 12px 0 calc(12px + env(safe-area-inset-bottom));
        background: black;
        color: white;
    }

        footer svg {
            width: 28px;
            height: 28px;
            fill: white;
        }

        footer button {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 1rem;
        }
</style>
