        new() { Name = "Riordinare", Description = "Mettere in ordine camera o scrivania", Value = 5, Weight = 0 },
        new() { Name = "Aiuto in casa", Description = "Fare una faccenda senza che te la chiedano", Value = 5, Weight = 0 },
        new() { Name = "Tempo con la famiglia", Description = "Cenare o passare del tempo con i genitori o i fratelli", Value = 5, Weight = 0 },        new() { Name = "Strumento musicale", Description = "Suonare o esercitarsi per almeno 20 minuti", Value = 8, Weight = 0 },
        new() { Name = "Progetto personale", Description = "Lavorare per 1.5 ore a un progetto tuo (app, disegno, video, scrittura)", Value = 15, Weight = 0 },
       
       
    };

    private List<GoalAction> goal = new()
    {
        new() { Name = "9 o 10", Description = "Prendere 9 o 10 in una materia scientifica", Value = 5 },
        new() { Name = "7 o 8", Description = "Prendere 7 o 8 in una materia scientifica", Value = 3 },
        new() { Name = "Entrare al POLITO", Description = "Entrare al POLITO", Value = 10 },
    };



    private async Task Apply(HabitAction action)
    {
        points += action.Value;
        await SavingService.SaveAsync("points", points);
        await History.AddAsync(action.Name, action.Value);
    }

    protected override async Task OnInitializedAsync()
    {
        await SavingService.DeleteAsync("goals");
        points = await SavingService.LoadAsync<int>("points");
        GoalPoint = await SavingService.LoadAsync<int>("goalpoints");

        var saved = await SavingService.LoadAsync<List<GoalAction>>("goals");
        if (saved is not null)
            goal = saved;
        await SavingService.DeleteAsync("goals");
    }

    private void AddGoal()
    {
        GoalPopUpVisible = true;
    }

    private async Task ClearGoals()
    {
        GoalPoint = 0;

        await SavingService.SaveAsync("goalpoints", GoalPoint);
        await SavingService.DeleteAsync("goals");
    }

    private string GetBackgroundColor(int value)
    {
        if (value < -25) return "red";
        if (value < 0) return "orange";
        if (value < 25) return "blue";
        return "gold";
    }


    private string GetBackgroundColorGoal(int GoalPoint)
    {
        if (GoalPoint < 25) return "goal-bronze";
        if (GoalPoint < 75) return "goal-silver";
        if (GoalPoint < 150) return "goal-gold";
        if (GoalPoint < 300) return "goal-platinum";
        return "goal-diamond";
    }

    private string TrackStyle => $"transform: translateX({-page * 100}%);";

    private void OnPointerDown(PointerEventArgs e)
    {
        startX = e.ClientX;
        startY = e.ClientY;
    }

    private void OnPointerCancel(PointerEventArgs e)
    {
        startX = null;
    }


    private void OnPointerUp(PointerEventArgs e)
    {
        if (startX is null) return;

        double dx = e.ClientX - startX.Value;
        double dy = e.ClientY - startY;
        startX = null;

        // Ignora movimenti brevi o prevalentemente verticali
        if (Math.Abs(dx) < 60 || Math.Abs(dy) > Math.Abs(dx))
            return;

        // Swipe verso sinistra: apri Goals
        if (dx < 0)
            Nav.NavigateTo("/goals");
    }


    private string name = "";
    private int value;

    private async Task Confirm()
    {
        if (string.IsNullOrWhiteSpace(name)) return;

        goal.Add(new GoalAction
        {
            Name = name,
            Value = Math.Clamp(value, 1, 5)   // limita a 1-5 come dice il placeholder
        });

        await SavingService.SaveAsync("goals", goal);

        name = "";
        value = 0;
        GoalPopUpVisible = false;
    }

    private void Cancel()
    {
        GoalPopUpVisible = false;
    }

    private GoalAction? goalToDelete;

    private void AskDelete(GoalAction g)
    {
        goalToDelete = g;
    }

    private void CancelDelete()
    {
        goalToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (goalToDelete is null) return;

        goal.Remove(goalToDelete);
        await SavingService.SaveAsync("goals", goal);   // aggiorna anche il file su disco

        goalToDelete = null;
    }
}

