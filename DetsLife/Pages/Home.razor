    private int points;
    private int GoalPoint;
    private int page;               // 0 = azioni, 1 = obiettivi
    private double? startX;
    private double startY;
    private bool GoalPopUpVisible = false;
    private bool showPrize;
    private HabitAction? randomAction;

    private int NextPrizeDist => 10 - GoalPoint % 10;

    private int ActiveIndex
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri)
                          .Split('?')[0]
                          .Trim('/')
                          .ToLowerInvariant();

            return path switch
            {
                "finances" => 0,
                "timeline" => 1,
                "calendar" => 2,
                _ => 0
            };
        }
    }

    private void GoTo(string route)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri)
                         .Split('?')[0]
                         .Trim('/');

        if (!string.Equals(current, route, StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo(route);
    }


    private async Task Apply(GoalAction goalAction)
    {
        int before = GoalPoint;
        GoalPoint += goalAction.Value;
        await SavingService.SaveAsync("goalpoints", GoalPoint);

        if (GoalPoint / 10 > before / 10)   // ha superato una decina
        {
            PickRandomReward();
            showPrize = true;
        }
    }

    private void PickRandomReward()
    {
        var rewards = actions.Where(a => a.Value < 0 && a.Weight > 0).ToList();

        if (rewards.Count == 0)
        {
            randomAction = new HabitAction { Name = "Nessuna ricompensa", Value = 0 };
            return;
        }

        double total = rewards.Sum(r => r.Weight);
        double roll = Random.Shared.NextDouble() * total;

        foreach (var r in rewards)
        {
            roll -= r.Weight;
            if (roll < 0)
            {
                randomAction = r;
                return;
            }
        }

        randomAction = rewards[^1];   // salvaguardia per errori di arrotondamento
    }

    private void ClosePrize() => showPrize = false;


