@page "/"
@inject NavigationManager Nav
@inject HistoryService History
@inject ISavingService SavingService
@using Microsoft.AspNetCore.Components.Web
@using Dets.Models
@using Dets.Services
@inject IJSRuntime JS


<header class="header">
    <h1>DETS Life</h1>
</header>

<div class="InfoBox">
    <button class="PointBtn @GetBackgroundColor(points)" @onclick='() => Nav.NavigateTo("timeline")'>
        <h2>@points</h2>
    </button>

    <button class="GoalPointBtn @GetBackgroundColorGoal(GoalPoint)" @onclick='() => Nav.NavigateTo("timeline")'>
        <h2>@GoalPoint</h2>
    </button>
</div>

<div class="BtnBox">
    @foreach (var action in TopRecent())
    {
        <button class="ActionButton"
                style="@BgStyle(action.Name)"
                @onclick="() => Apply(action.Name, action.Value)">

            <span class="ActionName">@action.Name</span>

            <span class="ActionValue">
                @(action.Value > 0 ? "+" : "")@action.Value
            </span>
        </button>
    }
</div>

