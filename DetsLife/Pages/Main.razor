@page "/"
@inject NavigationManager Nav
@inject HistoryService History
@inject ISavingService SavingService
@inject HistoryService History
@using Microsoft.AspNetCore.Components.Web
@using Dets.Models
@using Dets.Services
@using System.Globalization
@inject IJSRuntime JS


<header class="header">
    <h1>DETS Life</h1>
</header>

<div class="InfoBox">
    <button class="PointBtn @GetBackgroundColor(points)" @onclick='() => Nav.NavigateTo("home")'>
        <h2>@points</h2>
    </button>

    <button class="GoalPointBtn @GetBackgroundColorGoal(GoalPoint)" @onclick='() => Nav.NavigateTo("home")'>
        <h2>@GoalPoint</h2>
    </button>
</div>

<div class="BtnBox">
    @foreach (var action in TopRecent())
    {
        <button class="ActionButton"
                style="@BgStyle(action.Name)"
                @onclick="() => Apply(action.Name, action.Value)">

            <span class="ActionName">@action.Name</span>

            <span class="ActionValue">
                @(action.Value > 0 ? "+" : "")@action.Value
            </span>
        </button>
    }
</div>

<div>
    <div class="FinanceBox">
        <button class="EventBtn" @onclick="ShowPopUp">
            <h2>Aggiungi transazione</h2>
        </button>
    </div>
    <div class="ToDoBox">
        <h1>ToDo List</h1>
        <h3>@DateTime.Today.ToString("D", CultureInfo.CurrentCulture)</h3>
            <ul>
                @foreach (var ev in events)
                {
                    @if(ev.Day == DateTime.Today.Day && ev.Month == DateTime.Today.Month && ev.Year == DateTime.Today.Year)
                    {
                    <li>
                        <strong>@ev.Name</strong>
                        (@ev.Day/@ev.Month/@ev.Year)
                        <br />
                        @ev.Description
                    </li>
                    }
            }
            </ul>
    </div>
</div>

<footer>
    @*TODO: aggiungi css e digli dove trovare il popup (non so fare)*@
    <button @onclick='() => Nav.NavigateTo("Finances")'>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cash" viewBox="0 0 16 16">
            <path d="M8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4" />
            <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V6a2 2 0 0 1-2-2z" />
        </svg>  <!--Finanze-->
    </button>
    <button @onclick='() => Nav.NavigateTo("timeline")'>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bar-chart" viewBox="0 0 16 16">
            <path d="M4 11H2v3h2zm5-4H7v7h2zm5-5v12h-2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM6 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm-5 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z" />
        </svg>  <!--Storico-->
    </button>
    <button @onclick='() => Nav.NavigateTo("calendar")'>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar-date" viewBox="0 0 16 16">
            <path d="M6.445 11.688V6.354h-.633A13 13 0 0 0 4.5 7.16v.695c.375-.257.969-.62 1.258-.777h.012v4.61zm1.188-1.305c.047.64.594 1.406 1.703 1.406 1.258 0 2-1.066 2-2.871 0-1.934-.781-2.668-1.953-2.668-.926 0-1.797.672-1.797 1.809 0 1.16.824 1.77 1.676 1.77.746 0 1.23-.376 1.383-.79h.027c-.004 1.316-.461 2.164-1.305 2.164-.664 0-1.008-.45-1.05-.82zm2.953-2.317c0 .696-.559 1.18-1.184 1.18-.601 0-1.144-.383-1.144-1.2 0-.823.582-1.21 1.168-1.21.633 0 1.16.398 1.16 1.23" />
            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z" />
