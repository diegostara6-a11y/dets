@if (showPopUp)
{
    <div class="PopupBackdrop" @onclick="ClosePopup">
        <div class="PopupBox" @onclick:stopPropagation="true">
            <h3>Aggiungi Transazione</h3>
            <h5>@selected.ToString("dddd d MMMM yyyy", it)</h5>

            <label for="transactionName">Nome transazione</label>
            <input id="transactionName"
                   class="PopupInput"
                   type="text"
                   @bind="transactionName"
                   placeholder="Es. Spesa supermercato" />

            <label for="transactionAmount">Importo</label>
            <input id="transactionAmount"
                   class="PopupInput"
                   type="number"
                   step="0.01"
                   @bind="transactionAmount" />

            <label>Categoria</label>
            <div class="CategoryDropdown">
                <button type="button"
                        class="CategorySelected"
                        @onclick="() => categoryOpen = !categoryOpen">
                    <span class="CategoryIcon">@((MarkupString)transactionCategory.Icon())</span>
                    <span class="CategoryName">@transactionCategory</span>
                    <span class="CategoryArrow">@(categoryOpen ? "▲" : "▼")</span>
                </button>

                @if (categoryOpen)
                {
                    <ul class="CategoryList">
                        @foreach (var cat in Enum.GetValues<Category>())
                        {
                            <li class="CategoryItem @(cat == transactionCategory ? "active" : "")"
                                @onclick="() => SelectCategory(cat)">
                                <span class="CategoryIcon">@((MarkupString)cat.Icon())</span>
                                <span class="CategoryName">@cat</span>
                            </li>
                        }
                    </ul>
                }
            </div>

            <label for="transactionNote">Nota</label>
            <textarea id="transactionNote"
                      class="PopupInput"
                      @bind="transactionNote"
                      placeholder="Nota (opzionale)"></textarea>

            <select class="PopupInput" @bind="transactionType">
                <option value="@TransactionType.Spesa">Spesa</option>
                <option value="@TransactionType.Entrata">Entrata</option>
            </select>

            <div class="PopupButtons">
                <button class="PopupBtn cancel" @onclick="ClosePopup">
                    Annulla
                </button>
                <button class="PopupBtn ok" @onclick="SaveTransaction">
                    Salva
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo it = new("it-IT");
    private int points;
    private int GoalPoint;
    private List<HistoryEntry>? entries;
    private List<DayStat>? stats;

    private bool showPopUp = false;
    private Dictionary<DateTime, int> totals = new();
    private DateTime month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime selected = DateTime.Today;
    private List<Event> events = new();                       
    private List<Transaction> transactions = new();          
    private string transactionName = "";
    private string transactionNote = "";
    private decimal transactionAmount = 1.0m;
    private Category transactionCategory = Category.Altro;
    private bool categoryOpen = false;
    private TransactionType transactionType = TransactionType.Spesa;

    private void SelectCategory(Category cat)
    {
        transactionCategory = cat;
        categoryOpen = false;
    }


    private void ClosePopup()
    {
        showPopUp = false;
    }
    
    private void ShowPopUp()
    {
        transactionName = "";
        transactionNote = "";
        transactionAmount = 1.0m;
        transactionCategory = Category.Altro;
        showPopUp = true;
        transactionType = TransactionType.Spesa;
    }

    private async Task SaveTransaction()
    {
        if (string.IsNullOrWhiteSpace(transactionName))
            return;

        var newTransaction = new Transaction
        {
            Name = transactionName.Trim(),
            Note = transactionNote.Trim(),
            Amount = transactionAmount,
            Category = transactionCategory,
            Date = selected,
            Type = transactionType,
        };

        transactions.Add(newTransaction);
        await SavingService.SaveAsync("transactions", transactions);

        ClosePopup();
    }


    protected override async Task OnInitializedAsync()
    {
        events = await SavingService.LoadAsync<List<Event>>("events")
                 ?? new List<Event>();
        entries = await History.GetRecentAsync();
        stats = await History.GetDailyAsync();
        points = await SavingService.LoadAsync<int>("points");
        GoalPoint = await SavingService.LoadAsync<int>("goalpoints");
        transactions = await SavingService.LoadAsync<List<Transaction>>("transactions")
                       ?? new List<Transaction>();
    }

    private async Task Apply(string name, int value)
    {
        points += value;
        await SavingService.SaveAsync("points", points);
        await History.AddAsync(name, value);
        entries = await History.GetRecentAsync();   // aggiorna la lista dei pulsanti
    }

    private string BgStyle(string name)
    {
        var img = ImageFor(name);

        if (img == "")
            return "background: linear-gradient(135deg, #292929, #111);";

        return $"background-image: linear-gradient(rgba(0,0,0,0.25), rgba(0,0,0,0.65)), url('{img}');";
    }

    private static readonly Dictionary<string, string> Images = new()
    {
        // 🔴 Azioni negative
        ["Videogiochi"] = "img/videogiochi.jpeg",
        ["Scroll infinito"] = "img/scroll_infinito.png",
        ["Salto palestra"] = "img/salto_palestra.png",
        ["Acquisto impulsivo"] = "img/Aquisto_impulsivo.jpeg",
        ["Pasto fuori casa"] = "img/pasto_fuori_casa.jpeg",
        ["Terea"] = "img/Terea.jpg",
        ["Sigarette"] = "img/Sigarette.jpg",
        ["Serate con alcol"] = "img/Serata_con_alcol.jpg",

        // 🟢 Azioni positive
        ["Palestra"] = "img/palestra.jpeg",
        ["Studiare"] = "img/studiare.jpeg",
        ["Leggere un libro"] = "img/Leggere_un_libro.jpg",
        ["Niente social"] = "img/No_social.jpg",
        ["Riordinare"] = "img/Riordinare.jpg",
        ["Aiuto in casa"] = "img/Pulire_casa.jpg",
        ["Tempo con la famiglia"] = "img/Tempo_in_famiglia.jpg",
        ["Strumento musicale"] = "img/chitarra.jpg",
        ["Progetto personale"] = "img/Progetto_personale.jpg"
    };

    private string ImageFor(string name) =>
        Images.TryGetValue(name, out var path) ? path : "";

    private List<(string Name, int Value)> TopRecent(int days = 7, int take = 7)
    {
        var from = DateTime.Now.AddDays(-days);

        var recent = (entries ?? new List<HistoryEntry>())
            .Where(e => e.Date >= from)
            .GroupBy(e => e.Name)
            .OrderByDescending(g => g.Count())
            .ThenByDescending(g => g.Max(x => x.Date))
            .Take(take)
            .Select(g => (
                Name: g.Key,
                Value: g.OrderByDescending(x => x.Date).First().Points
            ))
            .ToList();

        var fallback = new List<(string Name, int Value)>
    {
        ("Terea", -55),
        ("Studiare", 15),
        ("Leggere un libro", 10),
        ("Riordinare", 5),
        ("Serate con alcol", -35),
        ("Scroll infinito", -25),
        ("Niente social", 12)
    };

        foreach (var action in fallback)
        {
            if (recent.Count >= take)
                break;

            if (!recent.Any(x => x.Name == action.Name))
                recent.Add(action);
        }

        return recent;
    }


    private string GetBackgroundColor(int value)
    {
        if (value < -25) return "red";
        if (value < 0) return "orange";
        if (value < 25) return "blue";
        return "gold";
    }


    private string GetBackgroundColorGoal(int GoalPoint)
    {
        if (GoalPoint < 25) return "goal-bronze";
        if (GoalPoint < 75) return "goal-silver";
        if (GoalPoint < 150) return "goal-gold";
        if (GoalPoint < 300) return "goal-platinum";
        return "goal-diamond";
    }
}

